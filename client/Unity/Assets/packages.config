<?xml version="1.0" encoding="utf-8"?>
<packages>
  <!-- Offline Ragnarok GRF archive reader (MIT); editor-only importer uses it. -->
  <package id="GRF" version="0.3.1" />
  <package id="Ionic.Zlib.Core" version="1.0.0" />

  <!-- SignalR client packages -->
  <package id="Microsoft.AspNetCore.SignalR.Client" version="8.0.7" />
  <package id="Microsoft.AspNetCore.SignalR.Client.Core" version="8.0.7" />
  <package id="Microsoft.AspNetCore.Http.Connections.Client" version="8.0.7" />
  <package id="Microsoft.AspNetCore.Http.Connections.Common" version="8.0.7" />
  <package id="Microsoft.AspNetCore.SignalR.Common" version="8.0.7" />
  <package id="Microsoft.AspNetCore.SignalR.Protocols.Json" version="8.0.7" />

  <!-- Explicit transitive dependencies: NuGetForUnity CLI must import each
       assembly into Assets/Packages for Unity's compiler to resolve it. -->
  <package id="Microsoft.AspNetCore.Connections.Abstractions" version="8.0.7" />
  <package id="Microsoft.Bcl.TimeProvider" version="8.0.1" />
  <package id="Microsoft.Bcl.AsyncInterfaces" version="8.0.0" />
  <package id="Microsoft.Extensions.Features" version="8.0.7" />
  <package id="Microsoft.Extensions.DependencyInjection" version="8.0.0" />
  <package id="Microsoft.Extensions.DependencyInjection.Abstractions" version="8.0.0" />
  <package id="Microsoft.Extensions.Logging" version="8.0.0" />
  <package id="Microsoft.Extensions.Logging.Abstractions" version="8.0.0" />
  <package id="Microsoft.Extensions.Options" version="8.0.2" />
  <package id="Microsoft.Extensions.Primitives" version="8.0.0" />

  <!-- System.* dependencies required by the netstandard SignalR assemblies. -->
  <package id="System.Buffers" version="4.5.1" />
  <package id="System.Diagnostics.DiagnosticSource" version="8.0.0" />
  <package id="System.IO.Pipelines" version="8.0.0" />
  <package id="System.Memory" version="4.5.5" />
  <package id="System.Runtime.CompilerServices.Unsafe" version="6.0.0" />
  <package id="System.Text.Encodings.Web" version="8.0.0" />
  <package id="System.Text.Json" version="8.0.4" />
  <package id="System.Threading.Channels" version="8.0.0" />
  <package id="System.Threading.Tasks.Extensions" version="4.5.4" />
</packages>
